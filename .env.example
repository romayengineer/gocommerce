# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/maps
VITE_GOOGLE_MAPS_API_KEY=your_api_key_here

# S3 base URL for product images
VITE_S3_IMAGES_URL=https://gocommerce-assets-xxxxxxxx.s3.sa-east-1.amazonaws.com/images

# Currency code used to format prices (e.g. ARS, USD, EUR, BRL, GBP)
VITE_CURRENCY=ARS

# View configurability (mirrors container.config.view)
# Page max width (any CSS length, defaults to 80rem via --width-page)
VITE_PAGE_WIDTH=80rem
# Theme name mapped to [data-theme] overrides in app.css (default = :root tokens)
VITE_THEME=default

# Shop identity (mirrors container.config.shop/seo/pwa)
VITE_SHOP_NAME=ShopHub
VITE_SHOP_LOGO_URL=
VITE_SHOP_SUPPORT_EMAIL=
VITE_SEO_TITLE=
VITE_SEO_DESCRIPTION=An ecommerce store
VITE_THEME_COLOR=#2563eb
VITE_PWA_NAME=
VITE_PWA_SHORT_NAME=

# Home hero + featured grid (mirrors container.config.hero/home)
VITE_HERO_ENABLED=true
VITE_HERO_CTA_HREF=#/products
VITE_HERO_GRADIENT_FROM=primary-600
VITE_HERO_GRADIENT_TO=primary-800
VITE_FEATURED_COUNT=10

# Layout + footer toggles (true/false, all default true)
VITE_SHOW_HEADER=true
VITE_SHOW_FOOTER=true
VITE_STICKY_NAV=true
VITE_FOOTER_SHOW_SHOP=true
VITE_FOOTER_SHOW_COMPANY=true
VITE_FOOTER_SHOW_LEGAL=true
VITE_COPYRIGHT_YEAR=2024
VITE_SHOW_BUILT_BY=true

# Cart (mirrors container.config.cart)
VITE_TAX_RATE=10
