# Map provider (leaflet = default, no key needed | google = requires key below)
# Get your API key from: https://console.cloud.google.com/maps
VITE_MAP_PROVIDER=leaflet
VITE_GOOGLE_MAPS_API_KEY=your_api_key_here

# S3 base URL for product images
VITE_S3_IMAGES_URL=https://gocommerce-assets-xxxxxxxx.s3.sa-east-1.amazonaws.com/images

# Currency code used to format prices (e.g. ARS, USD, EUR, BRL, GBP)
VITE_CURRENCY=ARS

# View configurability (mirrors container.config.view)
# Page max width (any CSS length, defaults to 80rem via --width-page)
VITE_PAGE_WIDTH=80rem
# Theme name mapped to [data-theme] overrides in app.css (default = :root tokens)
VITE_THEME=default

# Style tokens (mirrors container.config.view.tokens). Colors are RGB triplets
# so Tailwind opacity modifiers keep working. Empty = pixel-identical default.
# Font stack for body text
VITE_FONT_SANS=
# Header / footer / card surfaces
VITE_HEADER_BG=
VITE_FOOTER_BG=
VITE_FOOTER_FG=
VITE_FOOTER_BORDER=
VITE_CARD_BG=
# Muted surfaces, borders and text scale
VITE_MUTED_BG=
VITE_MUTED_HOVER_BG=
VITE_BORDER_COLOR=
VITE_TEXT_COLOR=
VITE_TEXT_SECONDARY=
VITE_TEXT_MUTED=
VITE_TEXT_FAINT=
VITE_PLACEHOLDER_COLOR=
VITE_CHIP_TEXT=
# Feedback colors + on-color (text on filled primary/danger/badge)
VITE_DANGER_SOFT=
VITE_DANGER_BORDER=
VITE_DANGER_500=
VITE_DANGER_600=
VITE_DANGER_700=
VITE_SUCCESS_600=
VITE_ON_COLOR=

# Shop identity (mirrors container.config.shop/seo/pwa)
VITE_SHOP_NAME=GoCommerce
VITE_SHOP_LOGO_URL=
VITE_SHOP_SUPPORT_EMAIL=
# WhatsApp floating button (digits only, country code + number, e.g. 5491100000000). Empty = hidden.
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_MESSAGE=
VITE_SEO_TITLE=
VITE_SEO_DESCRIPTION=An ecommerce store
VITE_THEME_COLOR=#2563eb
VITE_PWA_NAME=
VITE_PWA_SHORT_NAME=

# Home hero + featured grid (mirrors container.config.hero/home)
VITE_HERO_ENABLED=true
VITE_HERO_CTA_HREF=#/products
VITE_HERO_GRADIENT_FROM=primary-600
VITE_HERO_GRADIENT_TO=primary-800
VITE_FEATURED_COUNT=10

# Layout + footer toggles (true/false, all default true)
VITE_SHOW_HEADER=true
VITE_SHOW_FOOTER=true
VITE_STICKY_NAV=true
VITE_FOOTER_SHOW_SHOP=true
VITE_FOOTER_SHOW_COMPANY=true
VITE_FOOTER_SHOW_LEGAL=true
VITE_COPYRIGHT_YEAR=2024
VITE_SHOW_BUILT_BY=true

# Cart (mirrors container.config.cart)
VITE_TAX_RATE=10

# Bank transfer details shown on payment view (mirrors container.config.bank)
VITE_BANK_NAME=Your Bank Name
VITE_BANK_ACCOUNT_ALIAS=your.account.alias
VITE_BANK_ACCOUNT_NUMBER=1234567890123456
VITE_BANK_ACCOUNT_NAME=Account Owner Name
