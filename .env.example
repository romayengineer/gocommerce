# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/maps
VITE_GOOGLE_MAPS_API_KEY=your_api_key_here

# S3 base URL for product images
VITE_S3_IMAGES_URL=https://gocommerce-assets-xxxxxxxx.s3.sa-east-1.amazonaws.com/images

# Currency code used to format prices (e.g. ARS, USD, EUR, BRL, GBP)
VITE_CURRENCY=ARS
