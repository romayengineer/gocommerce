{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/routes/**/*"],
      "project": ["src/**/*", "scripts/**/*"],
      "ignoreBinaries": ["tsc"],
      "ignoreDependencies": ["leaflet", "@types/google.maps", "@types/leaflet"]
    },
    "packages/*/*": {
      "project": ["src/**/*"]
    },
    "packages/adapters/maps": {
      "project": ["src/**/*"],
      "ignoreDependencies": ["@types/google.maps"]
    }
  }
}
