{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowArbitraryExtensions": true,
		"allowJs": true,
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"target": "ES2020",
		"types": ["google.maps"],
		"useDefineForClassFields": true
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.js",
		"vite.config.ts",
		"vitest.config.ts",
		"scripts/**/*.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"packages/**/*.js",
		"packages/**/*.ts",
		"packages/**/*.svelte"
	]
}
