{
  "name": "ecommerce-store",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "knip": "knip",
    "lint": "eslint packages src scripts vercel.ts eslint.config.js",
    "test": "vitest run",
    "postinstall": "svelte-kit sync",
    "verify": "npm run check:boundaries && npm run knip && npm run check && npm run lint && npm test"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/google.maps": "^3.64.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.9.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vercel/config": "^0.5.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^30.1.2",
    "knip": "^6.40.0",
    "postcss": "^8.4.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@gocommerce/composition": "*",
    "leaflet": "^1.9.4",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.55.10",
    "svelte-i18n": "^4.0.1"
  }
}
